{
  "name": "gas-cylinders-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "bun run gen && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "bun run gen && biome lint .",
    "lint:design": "oxlint",
    "format": "biome format --write .",
    "check": "bun run gen && biome check --write . && bun run typecheck && bun run lint:design",
    "gen": "bun run gen:routes",
    "gen:routes": "tsr generate",
    "typecheck": "bun run gen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-cli": "^1.166.13",
    "@tanstack/router-plugin": "^1.166.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.76.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@shadcn/lint": "^0.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "27.4.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
